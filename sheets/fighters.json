{
 "sheet": "fighters",
 "about": "One row per playable fighter. 'custom' is the player's own Tarnished with a loadout. Unknown cells are null until verified; preflight lists them.",
 "columns": {
  "id": "stable key used by every other sheet",
  "name": "display name (JUMP FORCE spelling)",
  "series": "manga series",
  "jf_dlc": "true if the fighter was paid DLC in JUMP FORCE",
  "abilities": "4 ability ids: 3 skills + 1 awakening skill (ultimate)",
  "awakening": "awakening transformation name in JUMP FORCE",
  "outfit": "EquipParamProtector ids [head, body, arms, legs] whose model the Tarnished wears while this fighter is active (cosmetic: model fields copied onto the worn rows in memory; 10000-10300 = bare); '$player' = own look",
  "recolor": "per piece [head, body, arms, legs]: target colour [r,g,b] the piece's textures are recoloured to (made on the player's PC from their own game files, as a new model), or null to keep the armor's colours; '$player' for own look",
  "skin": "per piece [head, body, arms, legs]: a fan-made model shipped with the mod (mod folder skins/<name>.bnd, entries that are Elden Ring's own left empty and filled from the player's files), or null; replaces the recolour for that piece",
  "skin_credit": "who made the skin models (shown in the listing credits)",
  "hair_model": "Elden Ring hair PartsId (body type A) while the fighter is active; null until picked from the in-game survey",
  "hair_rgb": "hair (and brow/beard) colour [r,g,b]",
  "skin_rgb": "skin colour [r,g,b] while the fighter is active",
  "body": "character-creator build sliders [head, chest, abdomen, arms, legs], 0-255",
  "height": "model scale (1.0 = the Tarnished's own height)",
  "aura_speffect": "SpEffectParam row whose visual effect (vfx ids only, none of its stats) is the fighter's aura while charging and in Awakening",
  "look_notes": "what the look must read as (drives the outfit pick and recolors)",
  "stat_profile": "row id in stat_profiles sheet",
  "verified": "true once the fighter was played in game with every column checked",
  "passive": "0.8.0: an extra defensive or movement ability for fighters whose kit is riskier than the rest (combat.rs / movement.rs Passive), or null",
  "bare_hands": "0.10.0: true = the fighter fights with bare hands: every weapon the player has equipped (in hand and sheathed) is dressed as Elden Ring's empty hand in memory, and LT / skill plays Endure's braced guard (the parry); false = the player's own weapons (Your Tarnished)",
  "move_weapon": "EquipParamWeapon row of a weapon the fighter draws for their abilities (Asta's Demon-Slayer Sword; the one on his back is part of his model), or null",
  "air_dash": "0.10.0: 'fly' = the air dash is a faster, longer Superman flight, fist first (Goku, All Might); 'dash' = the normal air dash",
  "particles": "the fighter's own particle effects drawn around them in fights (world_fx.rs): teal_lightning (Deku) or steam (All Might); 0.11.0 cut the rest, or null"
 },
