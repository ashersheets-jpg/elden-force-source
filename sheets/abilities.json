{
 "sheet": "abilities",
 "about": "One row per JUMP FORCE ability (names from JUMP FORCE). Damage scales the fighter's attack rating. Elden Ring visuals/animations are borrowed from the player's own Elden Ring; JUMP FORCE contributes the move, its name and its sounds/voice from the player's copy.",
 "columns": {
  "id": "stable key",
  "name": "JUMP FORCE ability name",
  "owner": "fighter id, or 'avatar' for JUMP FORCE avatar-exclusive",
  "slot": "skill (3 per fighter) or ultimate (needs a full Awakening gauge)",
  "delivery": "row id in deliveries sheet (the kind of move; the exact sequence is in scripts.rs)",
  "element": "Elden Ring damage type",
  "dmg_mult": "the whole move's damage on one enemy, x the fighter's attack rating (0.8.0: every skill deals 0.4 per Ki it costs, every ultimate 16: no fighter out-damages another)",
  "fp_cost": "FP (Ki) spent (0.8.0: x0.6)",
  "cooldown_s": "seconds before reuse (0.8.0: x0.75)",
  "range_m": "reach in metres",
  "charge": "hold to charge",
  "charge_s": "extra wind-up before the script starts (aura + voice); 0 = the script's own wind-up",
  "er_anim": "Elden Ring animation the Tarnished plays; -1 = none (v1: Elden Ring exposes no animation request to mods)",
  "er_bullet": "main vanilla Elden Ring BulletParam row of the ability's script (scripts.rs; all its bullets end by themselves when the mod fires them, lab/judge2.txt); cloned in memory, never shipped",
  "creator_pool": "available in the Your Tarnished loadout",
  "verified": "played in game, every cell checked",
  "kind": "how it hits, shown in the fighter select: melee (up close), aoe (an area around a spot), ranged (a projectile or beam)",
  "hits": "hits on one enemy the damage is split over; 0 = estimated from the script (scripts.rs expected_hits)",
  "combo": "a combo: a chain of hits, labeled COMBO in the fighter select and HUD"
 },
