------------------------------------------
-- Elden Force: the player's behaviour script.
-- Elden Ring's own player script is not part of Elden Force: at launch the mod copies it from the
-- player's game files to c0000_er.hks next to this file, and this script runs it, then adds:
--  * Animation canceling (Elden Force): once an attack is a quarter second in, pressing dodge cuts
--    the rest of it short: a roll the way the stick points, or a backstep.
--  * Air boost (from ELDEN VINS by mahku, used with his permission): hold L2 and press jump in the
--    air to boost; resets on landing.
--  * Body animations for Elden Force's own moves (double jump, air dash, slam, lunges, leaps, dives),
--    asked for by the mod's DLL through marker SpEffects.
------------------------------------------

local here = debug.getinfo(1, "S").source:sub(2):match("(.*/)"):gsub("/", "\\")
-- Both run through loadfile: code loaded this way sees the game's script functions (env, act, the
-- ACTION_ARM_* numbers), which this file itself does not.
-- the folder of these scripts (Elden Force writes its animation cues next to them)
JR_ScriptDir = here
local er_script = loadfile(here .. "c0000_er.hks")
er_script()
-- 2.0.5: the game's own functions that elden_force.lua wraps, as the game's script left them (plain global
-- assignments: no _G in this script engine), so Carian Combo Warriors can be put underneath them later
JR_RAW = {
    ExecAttack = ExecAttack,
    GetEvasionRequest = GetEvasionRequest,
    AttackCommonFunction = AttackCommonFunction,
    GetAttackRequest = GetAttackRequest,
    ExecFallStart = ExecFallStart,
    ExecEvent = ExecEvent,
    ExecEventAllBody = ExecEventAllBody,
    ExecEventNoReset = ExecEventNoReset,
    ExecEventSync = ExecEventSync,
    ExecEventSyncNoReset = ExecEventSyncNoReset,
    ExecEventHalfBlend = ExecEventHalfBlend,
    ExecEventHalfBlendNoReset = ExecEventHalfBlendNoReset,
    Update = Update,
}
local function restore_raw()
    ExecAttack = JR_RAW.ExecAttack
    GetEvasionRequest = JR_RAW.GetEvasionRequest
    AttackCommonFunction = JR_RAW.AttackCommonFunction
    GetAttackRequest = JR_RAW.GetAttackRequest
    ExecFallStart = JR_RAW.ExecFallStart
    ExecEvent = JR_RAW.ExecEvent
    ExecEventAllBody = JR_RAW.ExecEventAllBody
    ExecEventNoReset = JR_RAW.ExecEventNoReset
    ExecEventSync = JR_RAW.ExecEventSync
    ExecEventSyncNoReset = JR_RAW.ExecEventSyncNoReset
    ExecEventHalfBlend = JR_RAW.ExecEventHalfBlend
    ExecEventHalfBlendNoReset = JR_RAW.ExecEventHalfBlendNoReset
    Update = JR_RAW.Update
end
local function elden_force()
    local f = loadfile(here .. "elden_force.lua")
    f()
end
elden_force()
-- 1.2.0: Carian Combo Warriors (Nexus mods, used with its author's permission and credit) is the fighters'
-- moveset: its player script runs alongside the game's, and jr_dispatch.lua sends each of the game's calls
-- to theirs (fighters) or the game's own (Your Tarnished); the DLL picks with JR_UseCCW.
-- 2.0.5: loaded on the character's first update, and only for the player: every character on this script (Stands,
-- summoned villains) compiled its 1.25 MB too, and after many summons the scripts' memory ran out and the game
-- closed itself (the crash players saw about ten minutes in). The game's env() can't be asked while this file
-- loads (that crashed the game), but can be on an update. Then it is loaded in the 1.2.0 order: the game's
-- functions, the dispatcher over theirs and the game's, then elden_force.lua's additions over that.
JR_CCW_ON = false
function JR_UseCCW(on)
    JR_CCW_ON = on
end
local first_update = Update
local decided = false
function Update()
    -- (once only, even if the game kept calling this first function: after that it hands on to the Update now in place)
    if decided then
        return Update()
    end
    decided = true
    if env(IsCOMPlayer) == TRUE then
        Update = first_update
        return first_update()
    end
    local dispatch = loadfile(here .. "jr_dispatch.lua")
    local ccw_script = loadfile(here .. "c0000_ccw.hks")
    if dispatch == nil or ccw_script == nil then
        Update = first_update
        return first_update()
    end
    restore_raw()
    dispatch()
    JR_SaveVanilla()
    ccw_script()
    JR_SaveCCW()
    JR_Dispatch()
    elden_force()
    return Update()
end
